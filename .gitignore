# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.uv-cache/
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.hypothesis/
.ipynb_checkpoints/

# Secrets
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# SQLite databases (corpus + findings are never committed)
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
*.db
*.db-journal

# Lucid runtime artifacts
.lucid.lock
.lucid/
report/*.html
corpus/
# demo/corpus/ is a committed synthetic fixture — exempt from the corpus/ rule.
!demo/corpus/
!demo/corpus/**
# calibration-runs/ holds personal calibration runs (against user corpora)
# which must never be committed. Pattern uses /* not / so the prod3
# exception below can re-include — git can't re-include children of an
# excluded parent directory.
calibration-runs/*
# Exception: the canonical prod3 Module A SpiralBench run is the
# provenance for the calibration numbers cited in README.md and
# docs/calibration.md. Public Spiral-Bench v1.2 corpus only — no user data.
!calibration-runs/prod3/
.audit-logs/
.imports/

# Claude Code workspace
# Tracked: settings.json, hooks/, agents/, project-owned skills.
# Untracked: personal settings, runtime lock, OS noise, inherited third-party skills.
.claude/.DS_Store
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/skills/*
!.claude/skills/bump-prompt-version/
!.claude/skills/add-detection-module/

# IDE
.idea/
.vscode/
*.swp
*.swo
.gstack/
report/report
