<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Lucid — hackathon demo deck · {{ audit.id }}</title>
<style>
  /* ─────────────────────────────────────────────────────────────────
     LUCID HACKATHON DECK — generator-driven companion to the report.
     Aesthetic: cream paper editorial / Tufte intelligence brief.
     Tokens, typography, and component grammar are LITERALLY the same
     CSS variables as base.html.j2 — the deck reads as the same
     publication, in slide form. System fonts only.
     ───────────────────────────────────────────────────────────────── */

  /* Design tokens — synced with base.html.j2 */
  :root {
    --bg: #f8f4ec;
    --bg-card: #fefcf7;
    --bg-deep: #efe8d9;
    --rule: #d9d0bc;
    --rule-soft: #e6dfce;
    --ink: #14110d;
    --ink-soft: #2c2823;
    --slate: #4a5160;
    --slate-soft: #8b8678;
    --severity-high: #9b1c1c;
    --severity-mid: #b45309;
    --severity-low: #1d3a5e;
    --positive: #2d5a3d;
    --neutral: #8b8678;
    --accent: #a64a2e;
    --accent-soft: #d8a48c;
    --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-out-quart: cubic-bezier(0.25, 1, 0.5, 1);
  }
  * { box-sizing: border-box; }
  html, body {
    margin: 0; padding: 0;
    background: var(--bg);
    font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont,
                 "Segoe UI Variable Text", "Segoe UI", "Helvetica Neue",
                 Arial, sans-serif;
    color: var(--ink);
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    overflow: hidden;
  }
  .serif, h1, h2, h3, h4, .display {
    font-family: ui-serif, "New York", Charter, "Source Serif Pro",
                 "Iowan Old Style", "Apple Garamond", Georgia, serif;
    font-feature-settings: "ss01", "ss02";
  }
  code, pre, .mono {
    font-family: ui-monospace, "SF Mono", "JetBrains Mono", Menlo,
                 Consolas, monospace;
    font-size: 0.86em;
  }
  em { font-style: italic; }
  strong { font-weight: 600; }

  /* ───── Slide framework ─────
     Each <section.slide> is a viewport-locked page. Stack absolutely;
     show one at a time via opacity + pointer-events. */
  .deck {
    position: relative;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
  }
  .slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    padding: clamp(2.4rem, 5.5vh, 4.4rem) clamp(2.6rem, 7vw, 6rem) clamp(3.6rem, 6vh, 4.6rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s var(--ease-out-quart);
  }
  .slide.active { opacity: 1; pointer-events: auto; }

  /* Subtle paper vignette — same warmth as the report. */
  .slide::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at top right, rgba(255, 250, 240, 0.4), transparent 60%),
      radial-gradient(ellipse at bottom left, rgba(166, 74, 46, 0.035), transparent 50%);
    pointer-events: none;
  }
  /* Top oxide-red rule on every slide — matches report's lede top border. */
  .slide::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 56px;
    height: 4px;
    background: var(--accent);
  }

  /* ───── Slide chrome — masthead + page numbers ───── */
  .slide-masthead {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--slate);
    font-weight: 700;
    margin: 0 0 1.4rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--rule);
  }
  .slide-masthead .mast-divider {
    flex: 1;
    height: 1px;
    background: var(--rule);
    margin: 0 0.3rem;
  }
  .slide-masthead .mast-volume {
    font-family: ui-serif, Georgia, serif;
    font-style: italic;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: none;
    color: var(--ink-soft);
  }
  .slide-chrome {
    position: absolute;
    bottom: 1.35rem;
    left: clamp(2.6rem, 7vw, 6rem);
    right: clamp(2.6rem, 7vw, 6rem);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--slate-soft);
    z-index: 5;
  }
  .slide-chrome .runner {
    font-family: ui-serif, Georgia, serif;
    font-style: italic;
    text-transform: none;
    letter-spacing: 0.03em;
    color: var(--slate);
  }
  .slide-chrome .pagenum { font-variant-numeric: tabular-nums; }
  .slide-chrome .pagenum .total { color: var(--rule); margin-left: 0.3em; }

  /* ───── Display typography (same scale as report's hero/lede) ───── */
  .slide h1.display {
    font-size: clamp(2.6rem, 7.2vw, 6.4rem);
    line-height: 1.0;
    margin: 0 0 1.1rem;
    font-weight: 600;
    letter-spacing: -0.018em;
    color: var(--ink);
  }
  .slide h2.display {
    font-size: clamp(1.9rem, 4.4vw, 3.4rem);
    line-height: 1.08;
    margin: 0 0 0.9rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .slide h3 {
    font-size: clamp(1.1rem, 1.8vw, 1.55rem);
    line-height: 1.3;
    margin: 0 0 0.5rem;
    font-weight: 600;
    color: var(--ink);
  }
  .slide p { margin: 0.55rem 0; }

  /* Drop cap on the cover/lede paragraphs — matches report .hero-headline. */
  .drop-cap::first-letter {
    font-family: ui-serif, "New York", Charter, Georgia, serif;
    font-size: 3.6em;
    font-weight: 600;
    float: left;
    line-height: 0.85;
    margin: 0.1em 0.12em 0 0;
    color: var(--accent);
  }

  /* ───── Eyebrow — same as report ───── */
  .eyebrow {
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--slate);
    font-weight: 600;
    margin: 0 0 0.7rem;
  }
  .eyebrow .tick {
    display: inline-block;
    width: 14px; height: 1px;
    background: var(--accent);
    vertical-align: middle;
    margin-right: 0.5rem;
  }

  /* ───── Sample-disclosure — copied verbatim from base.html.j2 ───── */
  .sample-disclosure {
    margin: 1rem 0 0;
    padding: 0.65rem 0.95rem;
    background: transparent;
    border-left: 2px solid var(--rule);
    font-size: 0.94rem;
    color: var(--ink-soft);
    line-height: 1.55;
    max-width: 60ch;
  }
  .sample-disclosure .sd-line { margin: 0; }
  .sample-disclosure .sd-label {
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--slate);
    font-weight: 700;
    margin-right: 0.5rem;
  }
  .sample-disclosure strong { color: var(--ink); font-weight: 600; }
  .sample-disclosure em {
    font-family: ui-serif, "New York", Charter, Georgia, serif;
    font-style: italic;
    color: var(--severity-mid);
  }

  /* ───── Sidenote / marginalia — copied from base.html.j2 ───── */
  .sidenote {
    background: var(--bg-card);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--ink);
    padding: 0.95rem 1.15rem;
    margin: 1.2rem 0 0;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 62ch;
  }
  .sidenote .sn-title {
    font-family: ui-serif, Georgia, serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ink);
    margin: 0 0 0.35rem;
    font-style: italic;
  }

  /* ───── Lede — copied from base.html.j2 (#1 finding feature) ───── */
  .lede {
    margin: 1.2rem 0 0;
    padding: 1.4rem 1.7rem 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--severity-high);
    position: relative;
    max-width: 80ch;
  }
  .lede::before {
    content: "№\00a001";
    position: absolute;
    top: -0.95rem;
    left: 1.2rem;
    background: var(--bg);
    padding: 0 0.6rem;
    font-family: ui-serif, Georgia, serif;
    font-size: 0.78rem;
    font-style: italic;
    color: var(--severity-high);
    letter-spacing: 0.06em;
  }
  .lede-eyebrow {
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--severity-high);
    font-weight: 700;
    margin: 0 0 0.4rem;
  }
  .lede-title {
    font-family: ui-serif, Georgia, serif;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    line-height: 1.18;
    font-weight: 600;
    margin: 0 0 0.55rem;
    color: var(--ink);
    letter-spacing: -0.005em;
  }
  .lede-quote {
    margin: 0.7rem 0 0;
    padding: 0.5rem 0 0.4rem 1.3rem;
    border-left: 3px solid var(--severity-high);
    font-family: ui-serif, Georgia, serif;
    font-size: 1.04rem;
    line-height: 1.55;
    font-style: italic;
    color: var(--ink-soft);
  }
  .lede-quote::before { content: "“"; color: var(--severity-high); font-size: 1.2em; }
  .lede-quote::after { content: "”"; color: var(--severity-high); font-size: 1.2em; }

  /* ───── Severity dot ───── */
  .sev-dot {
    display: inline-block;
    width: 0.55rem; height: 0.55rem;
    border-radius: 50%;
    margin-right: 0.15rem;
    vertical-align: -1px;
  }
  .sev-high { background: var(--severity-high); }
  .sev-mid { background: var(--severity-mid); }
  .sev-low { background: var(--severity-low); }
  .sev-neutral { background: var(--neutral); }

  /* ───── Figure + caption — copied from base.html.j2 ───── */
  figure { margin: 0.9rem 0; }
  figcaption {
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--slate);
    margin-top: 0.55rem;
    padding-left: 0.8rem;
    border-left: 2px solid var(--rule-soft);
    max-width: 62ch;
  }
  figcaption .fig-num {
    font-family: ui-serif, Georgia, serif;
    font-weight: 700;
    font-style: italic;
    color: var(--ink);
    letter-spacing: 0.02em;
  }
  figcaption em { color: var(--ink-soft); font-style: italic; }

  /* ───── Two-column layout helper ───── */
  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: start;
  }
  .two-col.eq { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .three-col {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.8rem);
    align-items: start;
  }
  @media (max-width: 880px) {
    .two-col, .three-col { grid-template-columns: 1fr; }
  }

  /* ───── Stat panel — same shape as report .hero-stats ───── */
  .stat-panel {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem 1.6rem;
    padding: 1.1rem 1.3rem;
    background: var(--bg-card);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--accent);
    margin: 1rem 0 0;
  }
  .stat-panel .stat-num {
    font-family: ui-serif, Georgia, serif;
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    line-height: 1;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.02em;
  }
  .stat-panel .stat-label {
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--slate);
    margin-top: 0.3rem;
    font-weight: 600;
  }

  /* ───── Module list (slide: frameworks) ───── */
  .module-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem 1.6rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .module-list li {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr);
    gap: 0.6rem;
    align-items: baseline;
    padding: 0.6rem 0;
    border-top: 1px solid var(--rule);
  }
  .module-list .ml-letter {
    font-family: ui-serif, Georgia, serif;
    font-size: 1.6rem;
    line-height: 1;
    font-weight: 600;
    color: var(--accent);
  }
  .module-list .ml-name {
    font-family: ui-serif, Georgia, serif;
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 0.15rem;
    color: var(--ink);
  }
  .module-list .ml-cap {
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.78rem;
    color: var(--slate);
    margin: 0;
    line-height: 1.45;
  }
  .module-list .ml-cap code {
    font-size: 0.85em;
    color: var(--ink-soft);
  }

  /* ───── Module count strip (slide: by module) ───── */
  .module-strip {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 0.7rem;
    margin: 1.2rem 0 0;
  }
  .module-strip .ms {
    background: var(--bg-card);
    border: 1px solid var(--rule);
    padding: 0.7rem 0.6rem;
    text-align: center;
  }
  .module-strip .ms-letter {
    font-family: ui-serif, Georgia, serif;
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--accent);
    line-height: 1;
  }
  .module-strip .ms-count {
    font-family: ui-serif, Georgia, serif;
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1;
    margin: 0.4rem 0 0.15rem;
  }
  .module-strip .ms-name {
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--slate);
  }
  .module-strip .ms.muted .ms-count { color: var(--slate-soft); }

  /* ───── Conversation honor roll ───── */
  .honor-roll {
    columns: 2;
    column-gap: 2rem;
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--ink-soft);
    max-height: clamp(220px, 38vh, 380px);
    overflow: hidden;
  }
  .honor-roll li {
    break-inside: avoid;
    padding: 0.18rem 0;
    border-top: 1px solid var(--rule-soft);
    font-family: ui-serif, Georgia, serif;
  }
  .honor-roll li:first-child { border-top: 0; }
  .honor-roll li .hr-turns {
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.7rem;
    color: var(--slate-soft);
    font-variant-numeric: tabular-nums;
    margin-left: 0.4rem;
  }

  /* ───── CLI block (audit-loop slide) ───── */
  .cli {
    background: #14110d;
    color: #e9dec5;
    padding: 1.1rem 1.3rem;
    font-family: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, monospace;
    font-size: clamp(0.78rem, 1vw, 0.93rem);
    line-height: 1.55;
    margin: 0;
    border-left: 3px solid var(--accent);
    overflow: hidden;
    white-space: pre-wrap;
  }
  .cli .prompt { color: var(--accent-soft); font-weight: 700; }
  .cli .flag { color: #d8a48c; }
  .cli .comment { color: #8b8678; font-style: italic; }
  .cli .out { color: #f4ecd9; }
  .cli .out em { color: #e8c098; font-style: normal; font-weight: 700; }

  /* ───── Step list (audit-loop slide) ─────
     Two-row grid per item: counter in col 1 (rows 1-2), strong (title)
     in col 2 row 1, small (caption) in col 2 row 2. Without explicit
     placement the small flows back into col 1 of an implicit row 2 and
     collapses to one-word-per-line. */
  .step-list {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .step-list li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr);
    grid-template-rows: auto auto;
    column-gap: 0.85rem;
    row-gap: 0.15rem;
    padding: 0.7rem 0;
    border-top: 1px solid var(--rule);
    align-items: baseline;
  }
  .step-list li:first-child { border-top: 0; }
  .step-list li::before {
    content: counter(step, decimal-leading-zero);
    grid-column: 1;
    grid-row: 1 / span 2;
    font-family: ui-serif, Georgia, serif;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    line-height: 1.4;
    align-self: start;
  }
  .step-list strong {
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
    display: block;
    font-family: ui-serif, Georgia, serif;
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
  }
  .step-list small {
    grid-column: 2;
    grid-row: 2;
    min-width: 0;
    display: block;
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.78rem;
    color: var(--slate);
    line-height: 1.45;
  }

  /* ───── Cover slide overrides ───── */
  .cover { justify-content: center; }
  .cover .cover-title {
    font-family: ui-serif, "New York", Charter, Georgia, serif;
    font-size: clamp(4.5rem, 14vw, 11rem);
    line-height: 0.92;
    font-weight: 600;
    margin: 0 0 1.4rem;
    letter-spacing: -0.025em;
    color: var(--ink);
  }
  .cover .cover-deck {
    font-family: ui-serif, Georgia, serif;
    font-size: clamp(1.1rem, 1.8vw, 1.5rem);
    font-style: italic;
    color: var(--ink-soft);
    line-height: 1.45;
    margin: 0 0 1.4rem;
    max-width: 56ch;
  }
  .cover .cover-byline {
    margin-top: auto;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--slate);
    font-weight: 600;
  }
  .cover .cover-byline .byline-italic {
    font-family: ui-serif, Georgia, serif;
    font-style: italic;
    text-transform: none;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    font-weight: 500;
  }

  /* ───── Reveal animation ───── */
  .slide.active .reveal { opacity: 1; transform: translateY(0); }
  .reveal {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.5s var(--ease-out-quart),
      transform 0.5s var(--ease-out-quart);
  }
  .reveal:nth-child(1) { transition-delay: 0.04s; }
  .reveal:nth-child(2) { transition-delay: 0.14s; }
  .reveal:nth-child(3) { transition-delay: 0.24s; }
  .reveal:nth-child(4) { transition-delay: 0.34s; }
  .reveal:nth-child(5) { transition-delay: 0.44s; }
  .reveal:nth-child(6) { transition-delay: 0.54s; }
  .reveal:nth-child(7) { transition-delay: 0.64s; }
  .reveal:nth-child(8) { transition-delay: 0.74s; }
  @media (prefers-reduced-motion: reduce) {
    .slide, .reveal { transition: opacity 0.05s linear; transform: none; }
  }

  /* ───── Navigation pill ───── */
  .nav {
    position: fixed;
    bottom: 1.3rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 30;
    display: flex;
    gap: 0.4rem;
    align-items: center;
    background: var(--bg-card);
    border: 1px solid var(--rule);
    padding: 0.4rem 0.6rem;
    border-radius: 999px;
    box-shadow: 0 2px 12px rgba(20, 17, 13, 0.08);
    font-family: ui-sans-serif, system-ui, sans-serif;
  }
  .nav button {
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--slate);
    font-size: 0.74rem;
    padding: 0.22rem 0.55rem;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 600;
  }
  .nav button:hover { background: var(--bg-deep); color: var(--ink); }
  .nav button:disabled { opacity: 0.3; cursor: default; }
  .nav .nav-cur {
    font-family: ui-serif, Georgia, serif;
    font-style: italic;
    font-size: 0.88rem;
    color: var(--ink);
    padding: 0 0.45rem;
    font-variant-numeric: tabular-nums;
  }
  .nav .nav-cur .total { color: var(--slate-soft); margin-left: 0.3em; }

  .progress {
    position: fixed; top: 0; left: 0; right: 0;
    height: 2px;
