    bottom: 0.4rem;
    right: 0.6rem;
    z-index: 31;
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.62rem;
    color: var(--slate-soft);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    pointer-events: none;
