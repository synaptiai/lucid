  <span class="nav-cur" aria-live="polite"><span id="curNum">01</span><span class="total"> / 12</span></span>
  <button id="nextBtn" type="button" aria-label="Next slide">Next ›</button>
  <button id="notesBtn" type="button" aria-label="Toggle presenter notes">Notes</button>
