<aside class="presenter-overlay" id="presenterOverlay" aria-live="polite">
  <h6 id="presenterTitle">Speaker notes</h6>
  <div id="presenterContent">No notes for this slide.</div>
</aside>

<div class="hint">Arrow keys · N for notes · P to print</div>

<script>
(function () {
  var slides = Array.prototype.slice.call(document.querySelectorAll('.slide'));
  var total = slides.length;
  var idx = 0;
  var bar = document.getElementById('progressBar');
  var prevBtn = document.getElementById('prevBtn');
  var nextBtn = document.getElementById('nextBtn');
  var notesBtn = document.getElementById('notesBtn');
  var curNum = document.getElementById('curNum');
  var presenter = document.getElementById('presenterOverlay');
  var presenterTitle = document.getElementById('presenterTitle');
  var presenterContent = document.getElementById('presenterContent');

  function pad(n) { return n < 10 ? '0' + n : '' + n; }

  function show(i) {
    if (i < 0) i = 0;
    if (i >= total) i = total - 1;
    idx = i;
    slides.forEach(function (s, j) {
      if (j === i) s.classList.add('active');
      else s.classList.remove('active');
    });
    if (bar) bar.style.width = ((i + 1) / total * 100) + '%';
    if (curNum) curNum.textContent = pad(i + 1);
    if (prevBtn) prevBtn.disabled = (i === 0);
    if (nextBtn) nextBtn.disabled = (i === total - 1);
    var hash = '#slide-' + (i + 1);
    if (location.hash !== hash) {
      try { history.replaceState(null, '', hash); } catch (e) {}
    }
    updatePresenter();
  }

  function updatePresenter() {
    var s = slides[idx];
    if (!s) return;
    var note = s.querySelector('.speaker-notes');
    var title = s.getAttribute('data-title') || ('Slide ' + (idx + 1));
    presenterTitle.textContent = title + ' — speaker notes';
    presenterContent.innerHTML = note ? note.innerHTML : 'No notes for this slide.';
  }

  function bump(d) { show(idx + d); }

  if (prevBtn) prevBtn.addEventListener('click', function () { bump(-1); });
  if (nextBtn) nextBtn.addEventListener('click', function () { bump(+1); });
  if (notesBtn) notesBtn.addEventListener('click', function () {
    document.body.classList.toggle('presenter-on');
  });

  document.addEventListener('keydown', function (e) {
    if (e.target && /input|textarea|select/i.test(e.target.tagName)) return;
    switch (e.key) {
      case 'ArrowRight': case 'PageDown': case ' ': bump(+1); e.preventDefault(); break;
      case 'ArrowLeft': case 'PageUp': bump(-1); e.preventDefault(); break;
      case 'Home': show(0); e.preventDefault(); break;
      case 'End': show(total - 1); e.preventDefault(); break;
      case 'n': case 'N': document.body.classList.toggle('presenter-on'); break;
      case 'p': case 'P': window.print(); break;
      case 'Escape': document.body.classList.remove('presenter-on'); break;
    }
  });

  var touchStart = null;
  document.addEventListener('touchstart', function (e) {
    if (e.touches.length === 1) touchStart = e.touches[0].clientX;
  }, { passive: true });
  document.addEventListener('touchend', function (e) {
    if (touchStart === null) return;
    var dx = e.changedTouches[0].clientX - touchStart;
    if (Math.abs(dx) > 60) bump(dx < 0 ? +1 : -1);
    touchStart = null;
  }, { passive: true });

  function showFromHash() {
    var m = (location.hash || '').match(/#slide-(\d+)/);
    if (m) show(parseInt(m[1], 10) - 1);
  }
  window.addEventListener('hashchange', showFromHash);
  if (location.hash) showFromHash(); else show(0);
})();
</script>
