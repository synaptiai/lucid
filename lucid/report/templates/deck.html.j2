  .presenter-overlay code { font-family: ui-monospace, monospace; color: var(--accent-soft); }

  /* Print: page-per-slide; speaker notes appear below each slide. */
  @media print {
    body, html, .deck { overflow: visible; height: auto; background: white; }
    .slide {
      position: relative;
      page-break-after: always;
      opacity: 1 !important;
