  /* ───── Speaker / presenter notes ───── */
  .speaker-notes {
    position: absolute;
    width: 1px; height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0; padding: 0; margin: -1px;
  }
  .presenter-overlay {
    position: fixed;
    bottom: 5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 40;
    width: min(720px, 90vw);
    max-height: 40vh;
    overflow-y: auto;
    background: #14110d;
    color: #f0e8d6;
    padding: 1.3rem 1.6rem;
